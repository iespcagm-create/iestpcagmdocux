# Cabeceras de seguridad para Cloudflare Pages.
# Cloudflare lee este archivo desde la raíz del sitio publicado.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; img-src 'self' blob:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
